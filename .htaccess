# ============================================================
#  Kre8tive Minds — Apache/LiteSpeed config (Hostinger)
# ============================================================

# ---- Canonical host: force HTTPS + non-www -----------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www -> non-www (primary domain: kre8tiveminds.com)
  RewriteCond %{HTTP_HOST} ^www\.kre8tiveminds\.com$ [NC]
  RewriteRule ^ https://kre8tiveminds.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Compression (gzip; LiteSpeed also serves brotli) ------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Browser caching ---------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType image/x-icon        "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType text/html           "access plus 1 hour"
  ExpiresByType application/xml     "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Long, immutable cache for static assets (JS is ?v=-versioned)
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML revalidates quickly
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Default document --------------------------------------
DirectoryIndex index.html
